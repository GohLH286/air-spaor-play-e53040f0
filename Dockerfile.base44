# Development runtime for the Base44 sandbox.
# Source is bind-mounted at /workspace (no COPY) so edits are live.
FROM node:22-slim

ENV DEBIAN_FRONTEND=noninteractive \
    BUN_INSTALL_CACHE_DIR=/var/cache/bun \
    CI=true

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g bun@1 \
 && npm cache clean --force

WORKDIR /workspace
EXPOSE 3000
